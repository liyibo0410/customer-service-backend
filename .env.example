LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your key

# LLM 调用治理（统一在 infrastructure/llm.py 的包装函数里生效：
# 超时/重试/降级，避免模型侧抖动直接把请求打成 500）
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3
LLM_RETRY_DELAY_SECONDS=0.5

COMMERCE_API_BASE_URL=http://127.0.0.1:18081

# 课程 MySQL 容器（customer-service-mysql）发布在宿主 3307。
# 若你本机 3306 空闲，也可直接把课程 docker-compose.yml 的端口改回 3306:3306。
DATABASE_URL=mysql+aiomysql://root:itwwy123%40@127.0.0.1:3307/customer_service?charset=utf8mb4

# 是否打印 SQL：本地调试置 true 可看到每句 SQL，生产保持 false
DATABASE_ECHO=false

APP_HOST=127.0.0.1
APP_PORT=18082

# 数字人（魔珐星云）
# 到 https://xingyun3d.com/ 创建"具身驱动应用"后，把 App ID / App Secret 填在这里。
# AppSecret 等同应用密码，只能放后端，不要写进前端源码或提交到 Git。
DIGITAL_HUMAN_APP_ID=
DIGITAL_HUMAN_APP_SECRET=
DIGITAL_HUMAN_GATEWAY_SERVER=https://nebula-agent.xingyun3d.com/user/v1/ttsa/session

# 语音播报音色（edge-tts）
# 女声：zh-CN-XiaoxiaoNeural / zh-CN-XiaoyiNeural；男声：zh-CN-YunxiNeural / zh-CN-YunjianNeural
TTS_VOICE=zh-CN-XiaoxiaoNeural
